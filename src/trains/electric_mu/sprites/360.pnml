switch(FEAT_TRAINS, SELF, sw_BR360_2_can_attach_wagon, vehicle_type_id) {
	item_BR360_2_4car: return CB_RESULT_ATTACH_ALLOW;
	item_BR360_2_5car: return CB_RESULT_ATTACH_ALLOW;
	return string(STR_CANNOT_ATTACH);
}

// The body layer uses normal vehicle sprites only. The light layer selects the
// illuminated whole-consist end from OpenTTD's native backwards-running state;
// all intermediate cabs receive the empty overlay.
switch(FEAT_TRAINS, SELF, sw_BR360_1_body_layer,
		[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), position_in_articulated_veh % 4]) {
	0: sw_BR360_1_a; 1: sw_BR360_1_b; 2: sw_BR360_1_c; 3: sw_BR360_1_d;
	sw_BR360_1_a;
}
switch(FEAT_TRAINS, SELF, sw_BR360_2_body_layer,
		[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), vehicle_type_id]) {
	738: sw_BR360_2_4car_roles_fwd; 2738: sw_BR360_2_4car_roles_fwd;
	739: sw_BR360_2_5car_roles_fwd; 2739: sw_BR360_2_5car_roles_fwd;
	sw_BR360_2_4car_roles_fwd;
}
switch(FEAT_TRAINS, SELF, sw_BR360_lights_forward_from_end, position_in_consist_from_end) {
	0: spriteset_BR360_lights_rear_tail;
	spriteset_BR360_lights_off;
}
switch(FEAT_TRAINS, SELF, sw_BR360_lights_forward, position_in_consist) {
	0: spriteset_BR360_lights_front_head;
	sw_BR360_lights_forward_from_end;
}
switch(FEAT_TRAINS, SELF, sw_BR360_lights_backward_from_end, position_in_consist_from_end) {
	0: spriteset_BR360_lights_rear_head;
	spriteset_BR360_lights_off;
}
switch(FEAT_TRAINS, SELF, sw_BR360_lights_backward, position_in_consist) {
	0: spriteset_BR360_lights_front_tail;
	sw_BR360_lights_backward_from_end;
}
switch(FEAT_TRAINS, SELF, sw_BR360_light_layer,
		[STORE_TEMP(PALETTE_IDENTITY, 0x100), train_is_driving_backwards]) {
	1: sw_BR360_lights_backward;
	sw_BR360_lights_forward;
}
switch(FEAT_TRAINS, SELF, sw_BR360_1_sprite_stack, getbits(extra_callback_info1, 8, 8)) {
	1: sw_BR360_light_layer;
	sw_BR360_1_body_layer;
}
switch(FEAT_TRAINS, SELF, sw_BR360_2_sprite_stack, getbits(extra_callback_info1, 8, 8)) {
	1: sw_BR360_light_layer;
	sw_BR360_2_body_layer;
}