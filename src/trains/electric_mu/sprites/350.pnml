// ============================================================================
// Class 350 sprite and MW switch definitions
// ============================================================================
//
// The Class 350 uses OpenTTD's native backwards-running state.  Layer 0 draws
// the physical vehicle body without baked-in lamps.  Layer 1 draws headlights,
// tail lights, or an empty sprite according to the whole-consist end positions
// and train_is_driving_backwards.  This keeps intermediate cabs dark when two
// or more units are coupled, without mirroring or geographically swapping the
// vehicle graphics.
//
// CAR ROLE MAPPING (position a/b/c/d = articulated index 0/1/2/3)
//   a (0) = front cab
//   b (1) = 2nd car
//   c (2) = 3rd car
//   d (3) = rear cab
//
// ============================================================================


// ============================================================================
// SPRITESETS
// Source: gfx/EMU/350_450.png
//
// PNG layout convention:
//   Main sprites at x=0 and loading sprites at x=200.
//   Rows per Class 350 livery are in this order: a, b, c, d.
//
// Each Class 350 livery occupies four rows (4 * 25px = 100px). Compact Class
// 450 graphics follow at y=600 in the shared sheet.
// ============================================================================
spriteset(spriteset_BR350_Purchase, "gfx/EMU/350_450.png") { template_purchase(400, 0) }

// Direction-dependent light overlays. The fifth row is deliberately empty.
spriteset(spriteset_BR350_lights_a_head, "gfx/EMU/350_lights.png") { template_train32px_old(0, 0) }
spriteset(spriteset_BR350_lights_a_tail, "gfx/EMU/350_lights.png") { template_train32px_old(0, 25) }
spriteset(spriteset_BR350_lights_d_head, "gfx/EMU/350_lights.png") { template_train32px_old(0, 50) }
spriteset(spriteset_BR350_lights_d_tail, "gfx/EMU/350_lights.png") { template_train32px_old(0, 75) }
spriteset(spriteset_BR350_lights_off, "gfx/EMU/350_lights.png") { template_train32px_old(0, 100) }

// London Midland (y=0)
spriteset(spriteset_BR350a_LM, "gfx/EMU/350_450.png") { template_train32px_old(0, 0) }
spriteset(spriteset_BR350a_LM_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 0) }
spriteset(spriteset_BR350b_LM, "gfx/EMU/350_450.png") { template_train32px_old(0, 25) }
spriteset(spriteset_BR350b_LM_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 25) }
spriteset(spriteset_BR350c_LM, "gfx/EMU/350_450.png") { template_train32px_old(0, 50) }
spriteset(spriteset_BR350c_LM_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 50) }
spriteset(spriteset_BR350d_LM, "gfx/EMU/350_450.png") { template_train32px_old(0, 75) }
spriteset(spriteset_BR350d_LM_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 75) }

// Silverlink Central (y=100)
spriteset(spriteset_BR350a_SLinkCentral, "gfx/EMU/350_450.png") { template_train32px_old(0, 100) }
spriteset(spriteset_BR350a_SLinkCentral_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 100) }
spriteset(spriteset_BR350b_SLinkCentral, "gfx/EMU/350_450.png") { template_train32px_old(0, 125) }
spriteset(spriteset_BR350b_SLinkCentral_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 125) }
spriteset(spriteset_BR350c_SLinkCentral, "gfx/EMU/350_450.png") { template_train32px_old(0, 150) }
