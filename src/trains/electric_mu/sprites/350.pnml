// ============================================================================
// NATIVE BACKWARDS-RUNNING SPRITE STACK
//
// Layer 0 is the normal body sprite. Layer 1 is a palette-identity light
// overlay. No light layer asks for a further sprite, leaving room for a future
// pantograph/equipment layer between the body and lights.
// ============================================================================

switch(FEAT_TRAINS, SELF, sw_BR350_1_body_layer,
		[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100),
		 position_in_articulated_veh % 4]) {
	0: sw_BR350_1a; 1: sw_BR350_1b; 2: sw_BR350_1c; 3: sw_BR350_1d;
}
switch(FEAT_TRAINS, SELF, sw_BR350_2_body_layer,
		[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100),
		 position_in_articulated_veh % 4]) {
	0: sw_BR350_2a; 1: sw_BR350_2b; 2: sw_BR350_2c; 3: sw_BR350_2d;
}
switch(FEAT_TRAINS, SELF, sw_BR350_34_body_layer,
		[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100),
		 position_in_articulated_veh % 4]) {
	0: sw_BR350_34a; 1: sw_BR350_34b; 2: sw_BR350_34c; 3: sw_BR350_34d;
}

switch(FEAT_TRAINS, SELF, sw_BR350_lights_forward_from_end, position_in_consist_from_end) {
	0: spriteset_BR350_lights_d_tail;
	spriteset_BR350_lights_off;
}
switch(FEAT_TRAINS, SELF, sw_BR350_lights_forward, position_in_consist) {
	0: spriteset_BR350_lights_a_head;
	sw_BR350_lights_forward_from_end;
}
switch(FEAT_TRAINS, SELF, sw_BR350_lights_backward_from_end, position_in_consist_from_end) {
	0: spriteset_BR350_lights_d_head;
	spriteset_BR350_lights_off;
}
switch(FEAT_TRAINS, SELF, sw_BR350_lights_backward, position_in_consist) {
	0: spriteset_BR350_lights_a_tail;
	sw_BR350_lights_backward_from_end;
}
switch(FEAT_TRAINS, SELF, sw_BR350_light_layer,
		[STORE_TEMP(PALETTE_IDENTITY, 0x100), train_is_driving_backwards]) {
	1: sw_BR350_lights_backward;
	sw_BR350_lights_forward;
}

switch(FEAT_TRAINS, SELF, sw_BR350_1_sprite_stack, getbits(extra_callback_info1, 8, 8)) {
	1: sw_BR350_light_layer;
	sw_BR350_1_body_layer;
}
switch(FEAT_TRAINS, SELF, sw_BR350_2_sprite_stack, getbits(extra_callback_info1, 8, 8)) {
	1: sw_BR350_light_layer;
	sw_BR350_2_body_layer;
}
switch(FEAT_TRAINS, SELF, sw_BR350_34_sprite_stack, getbits(extra_callback_info1, 8, 8)) {
	1: sw_BR350_light_layer;
	sw_BR350_34_body_layer;
}
