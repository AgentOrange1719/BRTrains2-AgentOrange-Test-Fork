spriteset(spriteset_BR350d_LNWRSimple, "gfx/EMU/350_450.png") { template_train32px_old(0, 375) }
spriteset(spriteset_BR350d_LNWRSimple_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 375) }

// LNWR Full (y=400) - 350/1 and 350/3+4 only
spriteset(spriteset_BR350a_LNWRFull, "gfx/EMU/350_450.png") { template_train32px_old(0, 400) }
spriteset(spriteset_BR350a_LNWRFull_loading, "gfx/EMU/350_450.png") { template_train32px_old(200, 400) }
